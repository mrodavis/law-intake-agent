# Optional. Without it the service uses the offline keyword mock.
ANTHROPIC_API_KEY=
INTAKE_MODEL=claude-sonnet-5-5

# Shared secret with your email provider's webhook. Generated per run if unset.
WEBHOOK_SECRET=
# Bearer token for the /staff endpoints. Generated per run if unset.
STAFF_TOKEN=

PORT=3001
# Optional append-only JSONL audit log.
AUDIT_LOG_PATH=
